# ==============================================================================
# Fichier d'environnement de production LoueMoi (.env)
# ==============================================================================

# --- Domaine et SSL ---
DOMAIN=api.votredomaine.com
SSL_EMAIL=contact@votredomaine.com
# Mettre à true pour tester Certbot sans impacter les quotas Let's Encrypt
SSL_STAGING=false

# --- Sécurité Django ---
# Générez une clé avec : openssl rand -base64 48
DJANGO_SECRET_KEY=change_me_to_a_long_random_secret_key_at_least_50_chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.votredomaine.com,votredomaine.com,localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=https://api.votredomaine.com,https://votredomaine.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.votredomaine.com,https://votredomaine.com

# --- Base de données PostgreSQL ---
POSTGRES_DB=louemoi_db
POSTGRES_USER=louemoi_user
POSTGRES_PASSWORD=un_mot_de_passe_tres_securise_ici
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Administrateur unique LoueMoi (/admin/ et /dashboard/) ---
# L'identifiant est votre numéro de téléphone (demandé interactivement par ./deploy.sh)
DJANGO_SUPERUSER_PHONE=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_FIRST_NAME=
DJANGO_SUPERUSER_LAST_NAME=

# --- Données de démonstration ---
# Toujours à False en production : aucun compte démo ni fausse annonce
SEED_DEMO_DATA=False

# --- Performance Gunicorn ---
GUNICORN_WORKERS=3
GUNICORN_THREADS=2

# --- Firebase Push Notifications (Optionnel) ---
# Collez le contenu JSON complet de la clé de service Firebase sur une seule ligne si activé
FIREBASE_CREDENTIALS_JSON=

# --- Passerelle SMS OTP (IKODDI) ---
IKODDI_API_KEY=
IKODDI_ORG_ID=
IKODDI_OTP_APP_ID=
IKODDI_SENDER_ID=LoueMoi
IKODDI_API_URL=https://api.ikoddi.com/v1/sms/send


