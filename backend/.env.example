# ==============================================================================
# CONFIGURATION DU BACKEND LOUEMOI (Exemple de fichier .env)
# ==============================================================================
# Copiez ce fichier sous le nom ".env" dans le dossier "backend/" :
# cp .env.example .env

# --- CONFIGURATION DJANGO ---
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=changez_cette_cle_par_une_chaine_aleatoire_tres_longue_et_secrete
DJANGO_ALLOWED_HOSTS=transfert-online.site,www.transfert-online.site,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://transfert-online.site,https://www.transfert-online.site
DJANGO_CORS_ALLOWED_ORIGINS=https://transfert-online.site,https://www.transfert-online.site

# --- BASE DE DONNÉES (Optionnel : si omis, SQLite backend/db.sqlite3 sera utilisé) ---
# DATABASE_URL=postgres://louemoi_user:votre_mot_de_passe@localhost:5432/louemoi_db

# --- PASSERELLE SMS OTP (IKODDI / IKKODI) ---
# Utilisé pour envoyer le code OTP lors de "Mot de passe oublié"
# Obtenez vos identifiants sur : https://ikoddi.com
IKODDI_API_KEY=votre_cle_api_ikoddi_ici
IKODDI_SENDER_ID=LoueMoi
IKODDI_API_URL=https://api.ikoddi.com/v1/sms/send

# --- PASSERELLE PAIEMENT & ABONNEMENTS (JÈKO CHECKOUT) ---
# Utilisé pour encaisser les abonnements mensuels (Wave, Orange, MTN, Moov, Djamo)
# Obtenez vos identifiants sur le portail marchand : https://jeko.africa
JEKO_API_KEY=votre_cle_api_secrete_jeko_ici
JEKO_API_KEY_ID=votre_api_key_id_jeko_ici
JEKO_STORE_ID=votre_store_id_jeko_ici
JEKO_WEBHOOK_SECRET=votre_cle_secrete_webhook_jeko_ici
JEKO_API_URL=https://api.jeko.africa

# --- NOTIFICATIONS PUSH FIREBASE CLOUD MESSAGING (Optionnel) ---
# Contenu JSON brut du compte de service Firebase (sur une seule ligne)
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}

